# Ascendia — environment configuration.
# Copy this file to .env and fill in the values. Never commit the real .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres + pgvector) ---
POSTGRES_DB=ascendia
POSTGRES_USER=ascendia
POSTGRES_PASSWORD=change-me
# Use "db" when running through docker compose (service name),
# or "localhost" when running the app/tests directly on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
