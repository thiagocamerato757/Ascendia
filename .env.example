# Ascendia — environment configuration.
# Copy this file to .env and fill in the values. Never commit the real .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Master key for encrypting provider API keys at rest (Fernet, spec §5).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASCENDIA_FERNET_KEY=

# Host of your local model servers (Ollama, LM Studio, llama.cpp).
# docker compose already sets host.docker.internal; use localhost when running
# the app directly on your machine.
# ASCENDIA_LOCAL_LLM_HOST=localhost
#
# Hosts local server URLs may point to (comma-separated; "*" allows any).
# Default: localhost, 127.0.0.1, ::1, host.docker.internal and the host above.
# Add a model server on your network explicitly, e.g.:
# ASCENDIA_LOCAL_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,192.168.0.10

# --- Database (Postgres + pgvector) ---
POSTGRES_DB=ascendia
POSTGRES_USER=ascendia
POSTGRES_PASSWORD=change-me
# Use "db" when running through docker compose (service name),
# or "localhost" when running the app/tests directly on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Sources and RAG (all optional; defaults shown) ---
# Where uploaded source files are stored (private, never served).
# docker compose sets /data/sources (a volume shared by web and worker).
# ASCENDIA_SOURCES_ROOT=./private/sources
# ASCENDIA_SOURCE_MAX_MB=25
# ASCENDIA_SOURCE_MAX_PAGES=1000
# ASCENDIA_TEXT_SOURCE_MAX_CHARS=200000
# Chunking, in characters (paragraph-aware, with overlap).
# ASCENDIA_CHUNK_SIZE=1200
# ASCENDIA_CHUNK_OVERLAP=200
# ASCENDIA_EMBED_BATCH_SIZE=64
# Hybrid retrieval: candidates per method, RRF constant, passages sent to the model.
# ASCENDIA_RAG_CANDIDATES=40
# ASCENDIA_RAG_RRF_K=60
# ASCENDIA_RAG_TOP_K=8
# Per-user limits per minute.
# ASCENDIA_RATE_ASK_PER_MIN=20
# ASCENDIA_RATE_UPLOAD_PER_MIN=10
