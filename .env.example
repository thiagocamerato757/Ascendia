# Ascendia — environment configuration.
# Copy this file to .env and fill in the values. Never commit the real .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Master key for encrypting provider API keys at rest (Fernet, spec §5).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASCENDIA_FERNET_KEY=

# Host of your local model servers (Ollama, LM Studio, llama.cpp).
# docker compose already sets host.docker.internal; use localhost when running
# the app directly on your machine.
# ASCENDIA_LOCAL_LLM_HOST=localhost

# --- Database (Postgres + pgvector) ---
POSTGRES_DB=ascendia
POSTGRES_USER=ascendia
POSTGRES_PASSWORD=change-me
# Use "db" when running through docker compose (service name),
# or "localhost" when running the app/tests directly on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
